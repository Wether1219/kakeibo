generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// households本体は別機能のスコープ。categoriesのFK整合性のための最小限のスタブ。
model Household {
  id            BigInt         @id @default(autoincrement())
  categories    Category[]
  transactions  Transaction[]
  incomes       Income[]
  preSavings    PreSaving[]
  weeklyBudgets WeeklyBudget[]
  users         User[]
  auditLogs     AuditLog[]
  assets        Asset[]
  recurringTransactions RecurringTransaction[]
  savingsGoals  SavingsGoal[]

  @@map("households")
}

// users本体（認証）。email/password_hash/color_codeはJWT認証実装時に追加（docs/03_詳細設計書.md 1.2節）。
model User {
  id                    BigInt        @id @default(autoincrement())
  householdId           BigInt        @map("household_id")
  household             Household     @relation(fields: [householdId], references: [id])
  email                 String        @unique @db.VarChar(255)
  passwordHash          String        @map("password_hash") @db.VarChar(255)
  displayName           String        @map("display_name") @db.VarChar(50)
  colorCode             String?       @map("color_code") @db.VarChar(7)
  transactionsAsUser    Transaction[] @relation("TransactionUser")
  transactionsCreatedBy Transaction[] @relation("TransactionCreatedBy")
  incomes               Income[]
  preSavings            PreSaving[]
  auditLogs             AuditLog[]
  assets                Asset[]
  recurringTransactions RecurringTransaction[]

  @@map("users")
}

enum CategoryType {
  income
  pre_saving
  fixed_expense
  variable_expense
}

model Category {
  id            BigInt         @id @default(autoincrement())
  householdId   BigInt         @map("household_id")
  household     Household      @relation(fields: [householdId], references: [id])
  type          CategoryType
  name          String         @db.VarChar(50)
  icon          String?        @db.VarChar(10)
  sortOrder     Int            @default(0) @map("sort_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  transactions  Transaction[]
  incomes       Income[]
  preSavings    PreSaving[]
  weeklyBudgets WeeklyBudget[]
  recurringTransactions RecurringTransaction[]

  @@unique([householdId, type, name])
  @@map("categories")
}

enum SplitType {
  self
  shared
}

model Transaction {
  id              BigInt    @id @default(autoincrement())
  householdId     BigInt    @map("household_id")
  household       Household @relation(fields: [householdId], references: [id])
  transactionDate DateTime  @map("transaction_date") @db.Date
  categoryId      BigInt    @map("category_id")
  category        Category  @relation(fields: [categoryId], references: [id])
  splitType       SplitType @map("split_type")
  userId          BigInt?   @map("user_id")
  user            User?     @relation("TransactionUser", fields: [userId], references: [id])
  amount          Decimal   @db.Decimal(10, 0)
  memo            String?   @db.VarChar(255)
  createdBy       BigInt    @map("created_by")
  createdByUser   User      @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  // 定期取引から自動生成された場合の生成元（当月分の二重生成防止に使う）。手入力の場合はNULL。
  recurringTransactionId BigInt?               @map("recurring_transaction_id")
  recurringTransaction   RecurringTransaction?  @relation(fields: [recurringTransactionId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([householdId, transactionDate])
  @@index([householdId, categoryId])
  @@map("transactions")
}

model Income {
  id          BigInt    @id @default(autoincrement())
  householdId BigInt    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id])
  year        Int       @db.SmallInt
  month       Int       @db.TinyInt
  userId      BigInt    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  categoryId  BigInt    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id])
  amount      Decimal   @default(0) @db.Decimal(10, 0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([householdId, year, month, userId, categoryId])
  @@map("incomes")
}

model PreSaving {
  id           BigInt    @id @default(autoincrement())
  householdId  BigInt    @map("household_id")
  household    Household @relation(fields: [householdId], references: [id])
  year         Int       @db.SmallInt
  month        Int       @db.TinyInt
  userId       BigInt    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  categoryId   BigInt    @map("category_id")
  category     Category  @relation(fields: [categoryId], references: [id])
  budgetAmount Decimal   @default(0) @map("budget_amount") @db.Decimal(10, 0)
  actualAmount Decimal   @default(0) @map("actual_amount") @db.Decimal(10, 0)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([householdId, year, month, userId, categoryId])
  @@map("pre_savings")
}

// 実績はtransactionsから都度集計するため、本テーブルは予算額のみ保持する（docs/03_詳細設計書.md 1.7節）。
model WeeklyBudget {
  id           BigInt    @id @default(autoincrement())
  householdId  BigInt    @map("household_id")
  household    Household @relation(fields: [householdId], references: [id])
  year         Int       @db.SmallInt
  month        Int       @db.TinyInt
  weekNo       Int       @map("week_no") @db.TinyInt
  categoryId   BigInt    @map("category_id")
  category     Category  @relation(fields: [categoryId], references: [id])
  budgetAmount Decimal   @default(0) @map("budget_amount") @db.Decimal(10, 0)

  @@unique([householdId, year, month, weekNo, categoryId])
  @@map("weekly_budgets")
}

enum AssetGroup {
  cash_deposit
  securities
  insurance
}

model Asset {
  id                  BigInt         @id @default(autoincrement())
  householdId         BigInt         @map("household_id")
  household           Household      @relation(fields: [householdId], references: [id])
  assetGroup          AssetGroup     @map("asset_group")
  name                String         @db.VarChar(100)
  detail              String?        @db.VarChar(100)
  ownerUserId         BigInt         @map("owner_user_id")
  ownerUser           User           @relation(fields: [ownerUserId], references: [id])
  purpose             String?        @db.VarChar(100)
  monthlyContribution Decimal?       @map("monthly_contribution") @db.Decimal(10, 0)
  memo                String?        @db.VarChar(255)
  sortOrder           Int            @default(0) @map("sort_order")
  isActive            Boolean        @default(true) @map("is_active")
  balances            AssetBalance[]

  @@map("assets")
}

model AssetBalance {
  id        BigInt   @id @default(autoincrement())
  assetId   BigInt   @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id])
  year      Int      @db.SmallInt
  month     Int      @db.TinyInt
  balance   Decimal  @default(0) @db.Decimal(12, 0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assetId, year, month])
  @@map("asset_balances")
}

enum AuditAction {
  create
  update
  delete
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  householdId BigInt      @map("household_id")
  household   Household   @relation(fields: [householdId], references: [id])
  userId      BigInt      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  targetTable String      @map("target_table") @db.VarChar(50)
  targetId    BigInt      @map("target_id")
  action      AuditAction
  diffJson    Json?       @map("diff_json")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([householdId, targetTable])
  @@map("audit_logs")
}

// 毎月自動で発生する取引のテンプレート（家賃・サブスク等）。
// 生成された当月分transactionsから当月の最新状態を都度参照するため、実績値はここには持たない。
model RecurringTransaction {
  id           BigInt        @id @default(autoincrement())
  householdId  BigInt        @map("household_id")
  household    Household     @relation(fields: [householdId], references: [id])
  categoryId   BigInt        @map("category_id")
  category     Category      @relation(fields: [categoryId], references: [id])
  splitType    SplitType     @map("split_type")
  userId       BigInt?       @map("user_id")
  user         User?         @relation(fields: [userId], references: [id])
  amount       Decimal       @db.Decimal(10, 0)
  memo         String?       @db.VarChar(255)
  dayOfMonth   Int           @map("day_of_month") @db.TinyInt
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("recurring_transactions")
}

// 貯金目標。進捗（実績の貯金累計）は既存の年間集計API(GET /summary/annual)から
// フロント側で算出するため、本テーブルは目標額のみ保持する。
model SavingsGoal {
  id           BigInt    @id @default(autoincrement())
  householdId  BigInt    @map("household_id")
  household    Household @relation(fields: [householdId], references: [id])
  name         String    @db.VarChar(100)
  targetAmount Decimal   @map("target_amount") @db.Decimal(12, 0)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("savings_goals")
}
